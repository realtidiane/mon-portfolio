# Bloc Caddy du portfolio tidiane.deadsec.tech
#
# A installer dans /etc/caddy/conf.d/tidiane.caddy puis :
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Ne jamais reecrire /etc/caddy/Caddyfile : la racine est en lecture seule
# et route tous les sites via import (cf. skill vps-caddy-dashboard-conflict).

tidiane.deadsec.tech {
	# Les fichiers buildes par Vite (dist/) sont servis ici.
	root * /var/www/tidiane-portfolio

	# Le proxy Gemini : la cle API reste cote serveur.
	handle /api/chat {
		reverse_proxy 127.0.0.1:8787
	}

	# SPA React Router : /myworks et /play doivent renvoyer index.html.
	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		# blob: est necessaire pour :
		#  - worker-src : le decodeur DRACO du modele 3D tourne dans un Worker
		#  - connect-src: le modele chiffre est charge via fetch(blobUrl)
		#  - media-src  : les videos au survol des cartes projet
		#  - img-src    : les images de projets chargees en blob
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'"

		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		-Server
	}

	log {
		output file /var/log/caddy/tidiane.log
	}
}
