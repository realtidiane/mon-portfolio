[Unit]
Description=Proxy Gemini du portfolio tidiane.deadsec.tech
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tidiane
WorkingDirectory=/opt/tidiane-chat
EnvironmentFile=/opt/tidiane-chat/.env
ExecStart=/usr/bin/node /opt/tidiane-chat/chat-server.mjs
Restart=always
RestartSec=5
# Le proxy n'ecoute que sur 127.0.0.1 : Caddy fait le reverse_proxy.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/tidiane-chat

[Install]
WantedBy=multi-user.target
