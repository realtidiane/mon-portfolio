# Chat IA - cle Gemini (https://aistudio.google.com/apikey)
#
# Hebergement avec serverless function (la cle reste cote serveur) :
#   GEMINI_API_KEY=...
#
# Hebergement purement statique (la cle est incluse dans le bundle JS) :
#   VITE_GEMINI_API_KEY=...
#
# Modele utilise (defaut : gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
# VITE_GEMINI_MODEL=gemini-3.5-flash

GEMINI_API_KEY=your_actual_api_key_here
VITE_GEMINI_API_KEY=your_actual_api_key_here

